generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  SECRETARIA
  DAAC
  PROFESSOR
  ALUNO
  /// Conta pessoal do responsável técnico (§pedido do cliente 2026-08-18) — o único papel que
  /// vê /admin/reclamacoes; não gere mais nada no sistema. ADMIN ganhou acesso de envio (como
  /// Secretaria/Professor/Aluno) para reportar problemas a este papel, mas perdeu o de gestão.
  DEV
}

enum AlunoStatus {
  ATIVO
  TRANCADO
  FORMADO
  DESISTENTE
}

enum MatriculaStatus {
  ATIVA
  TRANCADA
  CONCLUIDA
}

/// Classificação do estudante — apenas informativo/relatório. Não afeta propinas, multas
/// ou bloqueio: confirmado com o diretor que bolseiros pagam propina integralmente (2026-08-13).
enum CategoriaEstudante {
  NORMAL
  BOLSEIRO_INAGBE
  COMPARTICIPADA
}

/// As 5 épocas fixas do MD §10 — cada TurmaDisciplina tem no máximo uma Avaliacao por época
/// (@@unique abaixo). Substitui o antigo AvaliacaoTipo livre (TESTE/TRABALHO/EXAME_FINAL) com
/// peso arbitrário: a fórmula de cálculo é fixa por contrato, não há avaliações livres a pesar.
enum Epoca {
  P1
  P2
  EXAME
  RECURSO
  EXAME_ESPECIAL
}

enum Periodo {
  MATUTINO
  VESPERTINO
  NOTURNO
}

enum DiaSemana {
  SEGUNDA
  TERCA
  QUARTA
  QUINTA
  SEXTA
  SABADO
}

model User {
  id              String     @id @default(cuid())
  name            String
  /// Obrigatório para staff (ADMIN/SECRETARIA/DAAC/PROFESSOR); alunos podem não ter email — nesse caso entram pelo numeroEstudante.
  email           String?    @unique
  /// Desnormalizado de Aluno.numeroEstudante para o login aceitar email OU nº de estudante sem join. Só preenchido para role=ALUNO.
  numeroEstudante String?    @unique
  /// Auto-serviço (Fase 12) — ADMIN/SECRETARIA/DAAC não têm Aluno/Professor onde guardar um telefone.
  /// Para ALUNO/PROFESSOR, mantido em sincronia com Aluno.telefone/Professor.telefone pela mesma ação.
  telefone        String?
  passwordHash    String
  deveTrocarSenha Boolean    @default(false)
  role            Role
  professorId     String?    @unique
  professor       Professor? @relation(fields: [professorId], references: [id])
  alunoId         String?    @unique
  aluno           Aluno?     @relation(fields: [alunoId], references: [id])
  createdAt       DateTime   @default(now())

  cobrancasRegistadas                 Cobranca[]               @relation("CobrancaRegistadaPor")
  configuracoesFinanceirasAtualizadas ConfiguracaoFinanceira[] @relation("ConfigFinanceiraAtualizadaPor")
  configuracoesAcademicasAtualizadas  ConfiguracaoAcademica[]  @relation("ConfigAcademicaAtualizadaPor")
  reclamacoes                         Reclamacao[]
  documentosCarregados                DocumentoAluno[]         @relation("DocumentoCarregadoPor")
}

model Professor {
  id            String   @id @default(cuid())
  nome          String
  email         String   @unique
  telefone      String
  especialidade String
  createdAt     DateTime @default(now())

  turmaDisciplinas TurmaDisciplina[]
  user             User?
  reclamacoes      Reclamacao[]
  /// Monografias que orienta (§2026-09-04) — o limite por professor está em
  /// ConfiguracaoAcademica.limiteOrientandosPorProfessor.
  orientandos      InscricaoCadeira[] @relation("Orientacao")
}

model Aluno {
  id                            String             @id @default(cuid())
  numeroEstudante               String             @unique
  nome                          String
  email                         String?            @unique
  telefone                      String?
  dataNascimento                DateTime
  genero                        String
  curso                         String
  anoIngresso                   Int
  anoCurricular                 Int                @default(1)
  status                        AlunoStatus        @default(ATIVO)
  categoria                     CategoriaEstudante @default(NORMAL)
  createdAt                     DateTime           @default(now())
  /// Nº de cadeiras que ficaram REPROVADO na última rematrícula processada (processarRematriculaAction)
  /// — alimenta o agravamento por cadeira em repetição na propina (§pedido do cliente 2026-08-18).
  /// Continua > 0 enquanto o aluno andar a repetir essas cadeiras, mesmo tendo avançado de ano.
  cadeirasReprovadasAnoAnterior Int                @default(0)

  matriculas  Matricula[]
  cobrancas   Cobranca[]
  inscricoes  InscricaoCadeira[]
  reclamacoes Reclamacao[]
  documentos  DocumentoAluno[]
  user        User?
}

/// Documentos administrativos anexados a um aluno pelo DAAC (certificado de transferência, BI,
/// etc.) — um "backlog" simples, sem categorias fixas por agora. Ficheiro em si vive no Vercel
/// Blob; blobUrl nunca é exposto ao browser diretamente (documentos sensíveis) — só lido do lado
/// do servidor pela route handler de download (src/app/api/documentos/[id]/route.tsx).
model DocumentoAluno {
  id             String   @id @default(cuid())
  alunoId        String
  aluno          Aluno    @relation(fields: [alunoId], references: [id], onDelete: Cascade)
  nome           String
  blobUrl        String
  blobPathname   String
  tamanhoBytes   Int
  tipoMime       String
  carregadoPorId String?
  carregadoPor   User?    @relation("DocumentoCarregadoPor", fields: [carregadoPorId], references: [id])
  createdAt      DateTime @default(now())

  @@index([alunoId])
}

model Curso {
  id          String @id @default(cuid())
  nome        String
  codigo      String @unique
  duracaoAnos Int

  disciplinas          Disciplina[]
  turmas               Turma[]
  cadeirasCurriculares CadeiraCurricular[]
}

/// Preço mensal da propina por categoria de estudante × ano curricular — igual em todos os
/// cursos (substituiu Curso.valorPropina em 2026-08-18, a pedido do cliente: 3 tipos de
/// estudante, preço por ano, sem distinção por curso). Gerido pelo DAAC em Admin > Preços.
model PrecoPropina {
  id            String             @id @default(cuid())
  categoria     CategoriaEstudante
  anoCurricular Int
  valor         Decimal            @db.Decimal(10, 2)

  @@unique([categoria, anoCurricular])
}

model Disciplina {
  id           String @id @default(cuid())
  nome         String
  codigo       String @unique
  cargaHoraria Int
  cursoId      String
  curso        Curso  @relation(fields: [cursoId], references: [id])

  turmaDisciplinas     TurmaDisciplina[]
  cadeirasCurriculares CadeiraCurricular[]
}

/// O "plano curricular": em que ano/semestre de um curso é que uma disciplina se leciona.
/// Não existia nenhum conceito disto antes — a atribuição de disciplinas a turmas era livre,
/// sem noção de "isto pertence ao 2º ano" (§4.2, correção do cliente: a cadeira é curso×disciplina×ano,
/// não só a disciplina — a mesma disciplina pode ter pesos/regras diferentes consoante o curso).
model CadeiraCurricular {
  id                 String     @id @default(cuid())
  cursoId            String
  curso              Curso      @relation(fields: [cursoId], references: [id])
  disciplinaId       String
  disciplina         Disciplina @relation(fields: [disciplinaId], references: [id])
  anoCurricular      Int
  semestre           Int
  /// Regras de dispensa (§4.1.1), geridas pelo DAAC. Algumas cadeiras podem não permitir dispensa
  /// (ex. laboratórios). Copiadas para InscricaoCadeira no momento da inscrição — ver nota lá.
  permiteDispensa    Boolean    @default(true)
  notaMinimaDispensa Decimal    @default(14) @db.Decimal(4, 2)
  /// §pedido do cliente 2026-09-04: no último ano o aluno tem a monografia em vez de cadeiras
  /// normais. Avaliada por uma defesa com nota ÚNICA (sem P1/P2, sem recurso — uma só chance),
  /// lançada só pelo DAAC/ADMIN. A nota grava-se na época EXAME por decisão deliberada: as 5
  /// épocas são uma cascata sequencial (cada uma exige a anterior, ver motivoAgendamentoInvalido)
  /// e a defesa não pertence a essa sequência. NA UI LÊ-SE SEMPRE "Defesa", nunca "Exame".
  eMonografia        Boolean    @default(false)

  turmaDisciplinas TurmaDisciplina[]
  inscricoes       InscricaoCadeira[]

  @@unique([cursoId, disciplinaId, anoCurricular, semestre])
}

/// Uma "turma" é uma coorte de alunos: Curso + Ano curricular + Período, num ano letivo.
model Turma {
  id            String  @id @default(cuid())
  cursoId       String
  curso         Curso   @relation(fields: [cursoId], references: [id])
  anoCurricular Int
  periodo       Periodo
  anoLetivo     Int

  matriculas       Matricula[]
  turmaDisciplinas TurmaDisciplina[]

  @@unique([cursoId, anoCurricular, periodo, anoLetivo])
}

/// Uma disciplina lecionada por um professor dentro de uma turma (coorte) — a oferta concreta de uma
/// CadeiraCurricular num ano letivo. `semestre` é copiado da CadeiraCurricular escolhida na criação
/// (deixa de ser um campo livre); mantido aqui por conveniência de query.
model TurmaDisciplina {
  id                  String            @id @default(cuid())
  turmaId             String
  turma               Turma             @relation(fields: [turmaId], references: [id], onDelete: Cascade)
  disciplinaId        String
  disciplina          Disciplina        @relation(fields: [disciplinaId], references: [id])
  cadeiraCurricularId String
  cadeiraCurricular   CadeiraCurricular @relation(fields: [cadeiraCurricularId], references: [id])
  /// Opcional (§pedido do cliente 2026-08-27): ao criar uma Turma, as disciplinas nascem
  /// automaticamente do plano curricular (CadeiraCurricular) e o DAAC só atribui o professor
  /// depois. Até lá a disciplina já existe — o aluno vê-a na sua lista e no horário, se já estiver
  /// programado. Sem professor, a pauta é só leitura: não há quem possa lançar notas ou marcar
  /// presenças (ver podeLancarNota).
  professorId         String?
  professor           Professor?        @relation(fields: [professorId], references: [id])
  semestre            Int
  sala                String

  avaliacoes   Avaliacao[]
  aulas        Aula[]
  horarioSlots HorarioSlot[]
  inscricoes   InscricaoCadeira[]

  // (turmaId, disciplinaId) permitiria só UMA oferta por disciplina por turma — mas
  // processarRematriculaAction procura a oferta de repetição por (cadeiraCurricularId,
  // turma.anoLetivo), não por disciplina: um aluno que avança de ano repetindo só uma cadeira
  // precisa de uma 2ª TurmaDisciplina na turma do ano seguinte, para a MESMA disciplina mas
  // ligada à CadeiraCurricular do ano anterior (a que está a repetir), coexistindo com a oferta
  // normal dessa disciplina no ano corrente.
  @@unique([turmaId, cadeiraCurricularId])
}

model HorarioSlot {
  id                String          @id @default(cuid())
  turmaDisciplinaId String
  turmaDisciplina   TurmaDisciplina @relation(fields: [turmaDisciplinaId], references: [id], onDelete: Cascade)
  diaSemana         DiaSemana
  horaInicio        String
  horaFim           String
  sala              String
}

model Matricula {
  id            String          @id @default(cuid())
  alunoId       String
  aluno         Aluno           @relation(fields: [alunoId], references: [id])
  turmaId       String
  turma         Turma           @relation(fields: [turmaId], references: [id])
  dataMatricula DateTime        @default(now())
  status        MatriculaStatus @default(ATIVA)

  cobrancas Cobranca[]

  @@unique([alunoId, turmaId])
}

/// A inscrição de um aluno numa CadeiraCurricular — é aqui, não na Matricula, que vive "está
/// inscrito nesta disciplina", para suportar repetentes (§4.2): um aluno do 3º ano a repetir uma
/// cadeira do 2º ano tem uma InscricaoCadeira própria, apontando para a TurmaDisciplina que
/// atualmente lecciona essa cadeira, independente da Turma em que está matriculado este ano.
/// Só pode haver uma tentativa ativa por cadeira de cada vez — aplicado em código, não em constraint.
model InscricaoCadeira {
  id                         String            @id @default(cuid())
  alunoId                    String
  aluno                      Aluno             @relation(fields: [alunoId], references: [id])
  cadeiraCurricularId        String
  cadeiraCurricular          CadeiraCurricular @relation(fields: [cadeiraCurricularId], references: [id])
  turmaDisciplinaId          String
  turmaDisciplina            TurmaDisciplina   @relation(fields: [turmaDisciplinaId], references: [id])
  tentativa                  Int               @default(1)
  ativa                      Boolean           @default(true)
  createdAt                  DateTime          @default(now())
  /// Congelamento de regras (§4.1.1, Fase 6): copiado de CadeiraCurricular no momento da criação
  /// desta inscrição. calcularNotaFinal usa sempre estes valores, nunca os atuais da cadeira — uma
  /// nota já lançada é facto histórico, mudar a regra no ano seguinte não reabre contas antigas.
  permiteDispensaAplicada    Boolean
  notaMinimaDispensaAplicada Decimal           @db.Decimal(4, 2)
  /// Aproveitamento de uma cadeira já aprovada noutra instituição (aluno transferido) — nunca
  /// frequentada aqui. Não entra em calcularNotaFinal (P1=P2=Exame=nota creditada faz a cascata
  /// já existente resolver sozinha); só metadado de exibição/auditoria.
  creditada                  Boolean           @default(false)
  instituicaoOrigemCreditado String?
  /// Congelado de CadeiraCurricular.eMonografia no momento da inscrição, pelo mesmo motivo de
  /// permiteDispensaAplicada: desmarcar a caixa no ano seguinte não pode transformar defesas já
  /// feitas em cadeiras normais, nem reabrir contas fechadas.
  eMonografiaAplicada        Boolean           @default(false)
  /// Orientador do finalista (§pedido do cliente 2026-09-04). Vive aqui e não no Aluno porque é
  /// por monografia: sobrevive ao histórico — quem orientou em 2027 continua a ser quem orientou,
  /// mesmo que o aluno repita ou mude de curso.
  orientadorId               String?
  orientador                 Professor?        @relation("Orientacao", fields: [orientadorId], references: [id])

  notas       Nota[]
  frequencias Frequencia[]

  @@unique([alunoId, cadeiraCurricularId, tentativa])
  // Cobre a contagem de orientandos por professor (validação do limite) e a página "Meus
  // Orientandos" — as duas leituras percorrem as inscrições de um orientador.
  @@index([orientadorId])
}

/// Uma prova de uma época fixa (§4.1/§4.3). No máximo uma por TurmaDisciplina×época — a fórmula
/// de cálculo (calcularNotaFinal) só conhece estes 5 pontos, não uma lista livre de provas.
model Avaliacao {
  id                String          @id @default(cuid())
  turmaDisciplinaId String
  turmaDisciplina   TurmaDisciplina @relation(fields: [turmaDisciplinaId], references: [id], onDelete: Cascade)
  epoca             Epoca
  data              DateTime
  sala              String?

  notas Nota[]

  @@unique([turmaDisciplinaId, epoca])
}

model Nota {
  id                 String           @id @default(cuid())
  avaliacaoId        String
  avaliacao          Avaliacao        @relation(fields: [avaliacaoId], references: [id])
  inscricaoCadeiraId String
  inscricaoCadeira   InscricaoCadeira @relation(fields: [inscricaoCadeiraId], references: [id])
  valor              Decimal          @db.Decimal(4, 2)
  /// True quando gerada pelo fecho do semestre (fecharSemestre) a quem ficou sem nota numa época
  /// já agendada — nunca escrita por uma Server Action. Distingue um 0 por falta de um 0 que o
  /// professor lançou de propósito. (Até §2026-09-02 vinha do prazo de lançamento a expirar.)
  automatica         Boolean          @default(false)
  lancadoEm          DateTime         @default(now())

  @@unique([avaliacaoId, inscricaoCadeiraId])
}

model Aula {
  id                String          @id @default(cuid())
  turmaDisciplinaId String
  turmaDisciplina   TurmaDisciplina @relation(fields: [turmaDisciplinaId], references: [id], onDelete: Cascade)
  data              DateTime
  tema              String?

  frequencias Frequencia[]
}

model Frequencia {
  id                 String           @id @default(cuid())
  aulaId             String
  aula               Aula             @relation(fields: [aulaId], references: [id])
  inscricaoCadeiraId String
  inscricaoCadeira   InscricaoCadeira @relation(fields: [inscricaoCadeiraId], references: [id])
  presente           Boolean
  justificada        Boolean?

  @@unique([aulaId, inscricaoCadeiraId])
}

model AuditLog {
  id            String   @id @default(cuid())
  userId        String?
  userName      String
  userRole      Role
  action        String
  entityType    String
  entityId      String?
  /// Valor estruturado antes/depois (§7) — só preenchido onde faz sentido (notas, pagamentos,
  /// preços, categoria). Substitui `details`, que nunca chegou a ser usado por nenhum call site.
  valorAnterior String?
  valorNovo     String?
  ipAddress     String?
  /// Data SIMULADA do evento (getAgora()) — a hora real vive em createdAt. Fora de
  /// SIMULATION_MODE é igual a createdAt; dentro, mantém a auditoria coerente com o tempo em que
  /// o sistema "acreditava" estar (senão avançar o relógio 6 meses deixava trilhos datados de hoje).
  dataEvento    DateTime @default(now())
  createdAt     DateTime @default(now())

  @@index([entityType, entityId])
  @@index([userId])
  @@index([createdAt])
}

enum CobrancaStatus {
  PENDENTE
  PAGO
}

/// Discriminador do tipo de cobrança (MD §2). PROPINA e MULTA são mensais (têm mesReferencia);
/// os restantes são pontuais, gerados quando o aluno solicita/é sujeito ao respetivo evento.
enum CobrancaTipo {
  INSCRICAO
  CONFIRMACAO
  MATRICULA
  PROPINA
  MULTA
  EMOLUMENTO
}

/// Um valor devido por um aluno — mensalidade, multa, ou outra cobrança pontual (MD §2).
/// Ligada à Matricula para saber curso/turma na altura, mas a unicidade e os totais são por Aluno,
/// para a dívida seguir o aluno mesmo que a matrícula mude.
/// Único (alunoId, tipo, mesReferencia) — para PROPINA/MULTA impede duplicados no mesmo mês;
/// para os tipos pontuais (mesReferencia null) não restringe, porque o Postgres trata NULL como
/// distinto em índices únicos, logo cada pedido pontual cria a sua própria linha.
model Cobranca {
  id             String         @id @default(cuid())
  matriculaId    String?
  matricula      Matricula?     @relation(fields: [matriculaId], references: [id])
  alunoId        String
  aluno          Aluno          @relation(fields: [alunoId], references: [id])
  tipo           CobrancaTipo
  mesReferencia  DateTime?
  descricao      String?
  valorDevido    Decimal        @db.Decimal(10, 2)
  valorPago      Decimal        @default(0) @db.Decimal(10, 2)
  status         CobrancaStatus @default(PENDENTE)
  dataVencimento DateTime
  dataPagamento  DateTime?
  registadoPorId String?
  registadoPor   User?          @relation("CobrancaRegistadaPor", fields: [registadoPorId], references: [id])
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@unique([alunoId, tipo, mesReferencia])
  @@index([alunoId, status])
  @@index([status])
  // Cobre o WHERE de getListaDevedores (status + tipo + poda por dataVencimento) — sem isto,
  // a lista de devedores fazia um scan completo do índice de status a cada carregamento do
  // dashboard e de /financeiro/devedores (achado pela corrida do cost-meter: p99 de 2-3.5s
  // com 1000 alunos/6000 cobranças).
  @@index([status, tipo, dataVencimento])
}

/// Catálogo de emolumentos (declarações, certidões, etc.) gerido pelo DAAC — mesmo padrão de
/// preço editável que Curso.valorPropina (§2.2). Só consulta para o aluno: o pedido e o pagamento
/// são presenciais na secretaria, que regista a Cobranca já paga. O nome/valor são copiados para
/// a Cobranca no momento do registo, por isso alterar o preço aqui não afeta pagamentos já feitos.
model Emolumento {
  id        String   @id @default(cuid())
  nome      String
  descricao String?
  valor     Decimal  @db.Decimal(10, 2)
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Configuração singleton do bloqueio por dívida (id fixo "config").
model ConfiguracaoFinanceira {
  id                               String    @id @default("config")
  bloqueioAtivo                    Boolean   @default(true)
  toleranciaDias                   Int       @default(0)
  diaVencimento                    Int       @default(10)
  valorMulta                       Decimal   @default(5000) @db.Decimal(10, 2)
  /// % agravada sobre a mensalidade por cada cadeira em repetição (Aluno.cadeirasReprovadasAnoAnterior)
  /// — editado em Admin > Preços, não em Admin > Financeiro > Configuração, mas guardado aqui porque
  /// gerarCobrancasDoDia já carrega esta linha a cada geração de propinas (evita outra query no hot path).
  percentagemAgravamentoPorCadeira Decimal   @default(0) @db.Decimal(5, 2)
  /// Multa por rematrícula tardia — confirmada pela ADMIN fora da janela de matrícula
  /// (§pedido do cliente 2026-08). 0 = desligada (defeito). Nasce como Cobranca MULTA órfã,
  /// presa ao aluno, confirmável/reversível só pela ADMIN (toggleMultaAction).
  valorMultaRematriculaTardia      Decimal   @default(0) @db.Decimal(10, 2)
  /// Marca a última corrida da geração automática de propinas/multas — evita repeti-la em cada request (§2).
  ultimaGeracaoEm                  DateTime?
  updatedAt                        DateTime  @updatedAt
  updatedPorId                     String?
  updatedPor                       User?     @relation("ConfigFinanceiraAtualizadaPor", fields: [updatedPorId], references: [id])
}

/// O que acontece às cadeiras já aprovadas de um aluno retido (Fase 8b) — configurável pelo DAAC
/// em vez de fixo no código, a pedido explícito (mesmo espírito de `permiteDispensa` na Fase 6).
enum RegraRetencao {
  SO_REPROVADAS
  ANO_INTEIRO
}

/// Relógio simulado (id fixo "config") — a "máquina do tempo" do papel DEV. Quando
/// `SIMULATION_MODE=true`, `getAgora()` (src/lib/tempo.ts) lê a data daqui em vez da hora real,
/// e o DEV pode avançá-la pela página /dev/relogio para ver o sistema reagir (geração de
/// propinas/multas, suspensão automática, rollover de turmas) como se o tempo tivesse passado.
/// Vive na BD (não num ficheiro) para funcionar também em deploys serverless/self-hosted, onde
/// o filesystem não é partilhado nem gravável. Fora de `SIMULATION_MODE` é completamente ignorado.
model RelogioSimulado {
  id        String   @id @default("config")
  agora     DateTime
  updatedAt DateTime @updatedAt
}

/// Telemetria da simulação (só escrita com SIMULATION_MODE=true). Captura tudo o que acontece
/// sob tempo acelerado para análise posterior: saltos do relógio, corridas dos jobs preguiçosos
/// (garantir*), acessos ao dashboard por papel. Escrita fire-and-forget — nunca bloqueia nem
/// derruba a ação que a originou. A análise vive em scripts/telemetria/relatorio.ts.
enum SimEventoTipo {
  SALTO_RELOGIO
  REPOR_RELOGIO
  JOB_GARANTIR
  ACESSO_DASHBOARD
  AGENTE_SIMULACAO
}

model SimEvento {
  id           String        @id @default(cuid())
  tipo         SimEventoTipo
  /// Data SIMULADA no momento do evento (getAgora()).
  dataSimulada DateTime
  /// Hora real do servidor — é esta que mede latências e permite reconstruir a linha temporal real.
  dataReal     DateTime      @default(now())
  /// Offset simulado-real em ms no momento do evento (dataSimulada - dataReal).
  offsetMs     BigInt
  userId       String?
  userRole     String?
  /// Ex.: "garantirCobrancasGeradas", "/financeiro", "avancarRelogio +30d".
  etiqueta     String
  detalhes     Json?
  duracaoMs    Int?

  @@index([tipo])
  @@index([dataSimulada])
  @@index([tipo, dataSimulada])
}

/// Configuração singleton da rematrícula/retenção (id fixo "config", §4.2/8b — não é promoção
/// automática em lote: a Secretaria aciona aluno a aluno via processarRematriculaAction, só dentro
/// da janela [matriculaInicio, matriculaFim]).
model ConfiguracaoAcademica {
  id                            String        @id @default("config")
  limiteReprovacoes             Int           @default(2)
  regraRetencao                 RegraRetencao @default(SO_REPROVADAS)
  matriculaInicio               DateTime?
  matriculaFim                  DateTime?
  /// Fronteira real do ano letivo — distinta da janela de matrícula (que só define quando a
  /// Secretaria pode processar rematrículas). É `anoLetivoFim`, não `matriculaFim`, que
  /// garantirSuspensaoAutomatica usa para detetar que um novo ano letivo começou.
  anoLetivoInicio               DateTime?
  anoLetivoFim                  DateTime?
  /// Marca a última corrida da suspensão automática de quem não rematriculou — evita repeti-la em cada request.
  ultimaSuspensaoEm             DateTime?
  /// Interruptor manual do DAAC (1 ou 2) — não é derivado de datas. Só disciplinas cujo
  /// TurmaDisciplina.semestre coincide com este valor (e do ano letivo corrente) ficam abertas
  /// para aulas/notas do professor. O DAAC continua sempre a poder editar qualquer semestre.
  /// FORA do ano letivo é reposto a 1 em cada visita ao dashboard (garantirSuspensaoAutomatica),
  /// não só na viragem: o rollover corre uma vez e qualquer alteração posterior — clique manual,
  /// seed, restauro de backup — ficava até ao fim do ano letivo seguinte (§2026-09-03).
  semestreAtual                 Int           @default(1)
  /// Máximo de monografias que um professor pode orientar ao mesmo tempo (§decisão do cliente
  /// 2026-09-04). 0 = sem limite. Validado em atribuirOrientadorAction, não no schema: o DAAC
  /// precisa de uma mensagem que diga QUEM está cheio, não um erro de constraint.
  limiteOrientandosPorProfessor Int           @default(5)
  /// Interruptor manual do DAAC/ADMIN (§decisão do cliente 2026-09-02): a true, TODOS os
  /// professores podem lançar notas das suas disciplinas; a false, nenhum. Substitui o prazo
  /// automático por época (diasPrazo*), que fechava sozinho N dias depois da prova.
  /// NÃO fecha sozinho — só um clique o fecha. O DAAC/ADMIN continua a ignorá-lo (podeLancarNota).
  lancamentoNotasAberto         Boolean       @default(true)
  /// Desde quando está no estado atual — sem data-limite, é esta a única referência temporal.
  /// O "quem" fica na AuditLog, que já regista o autor de cada alteração.
  lancamentoNotasAlteradoEm     DateTime?
  /// Marca a última corrida da sincronização das turmas com o plano curricular — rede de segurança
  /// diária para turmas que ficaram desalinhadas fora do fluxo normal (criadas antes de a oferta
  /// automática existir, plano alterado noutro ano letivo, importação manual).
  ultimaSincronizacaoPlanoEm    DateTime?
  updatedAt                     DateTime      @updatedAt
  updatedPorId                  String?
  updatedPor                    User?         @relation("ConfigAcademicaAtualizadaPor", fields: [updatedPorId], references: [id])
}

enum ReclamacaoCategoria {
  SUGESTAO
  RECLAMACAO
  PROBLEMA_TECNICO
  OUTRO
}

enum ReclamacaoStatus {
  PENDENTE
  EM_ANALISE
  RESOLVIDO
}

/// Canal de aluno ou professor para reportar problemas/sugestões sobre o próprio sistema — não é
/// um pedido académico nem financeiro, por isso não se encaixa em nenhum dos outros modelos. O
/// ADMIN (domínio de gestão geral) revê, muda o estado e pode deixar uma resposta curta — não é um
/// sistema de tickets com fio de conversa, só o suficiente para dar seguimento. Exatamente um de
/// alunoId/professorId/userId está preenchido (imposto em código, não em constraint de BD). userId
/// cobre staff sem Aluno/Professor próprio (SECRETARIA) — ver criarReclamacaoAction.
model Reclamacao {
  id          String              @id @default(cuid())
  alunoId     String?
  aluno       Aluno?              @relation(fields: [alunoId], references: [id])
  professorId String?
  professor   Professor?          @relation(fields: [professorId], references: [id])
  userId      String?
  user        User?               @relation(fields: [userId], references: [id])
  categoria   ReclamacaoCategoria @default(OUTRO)
  assunto     String
  mensagem    String
  status      ReclamacaoStatus    @default(PENDENTE)
  resposta    String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@index([alunoId])
  @@index([professorId])
  @@index([userId])
  @@index([status])
}
