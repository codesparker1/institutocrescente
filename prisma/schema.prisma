generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  SECRETARIA
  PROFESSOR
  ALUNO
}

enum AlunoStatus {
  ATIVO
  TRANCADO
  FORMADO
  DESISTENTE
}

enum MatriculaStatus {
  ATIVA
  TRANCADA
  CONCLUIDA
}

enum AvaliacaoTipo {
  TESTE
  TRABALHO
  EXAME_FINAL
}

enum Periodo {
  MATUTINO
  VESPERTINO
  NOTURNO
}

enum DiaSemana {
  SEGUNDA
  TERCA
  QUARTA
  QUINTA
  SEXTA
  SABADO
}

model User {
  id           String     @id @default(cuid())
  name         String
  email        String     @unique
  passwordHash String
  role         Role
  professorId  String?    @unique
  professor    Professor? @relation(fields: [professorId], references: [id])
  alunoId      String?    @unique
  aluno        Aluno?     @relation(fields: [alunoId], references: [id])
  createdAt    DateTime   @default(now())

  propinasRegistadas               Propina[]                 @relation("PropinaRegistadaPor")
  configuracoesFinanceirasAtualizadas ConfiguracaoFinanceira[] @relation("ConfigFinanceiraAtualizadaPor")
}

model Professor {
  id            String   @id @default(cuid())
  nome          String
  email         String   @unique
  telefone      String
  especialidade String
  createdAt     DateTime @default(now())

  turmaDisciplinas TurmaDisciplina[]
  user             User?
}

model Aluno {
  id              String      @id @default(cuid())
  numeroEstudante String      @unique
  nome            String
  email           String      @unique
  telefone        String
  dataNascimento  DateTime
  genero          String
  curso           String
  anoIngresso     Int
  anoCurricular   Int         @default(1)
  status          AlunoStatus @default(ATIVO)
  createdAt       DateTime    @default(now())

  matriculas Matricula[]
  propinas   Propina[]
  user       User?
}

model Curso {
  id          String @id @default(cuid())
  nome        String
  codigo      String @unique
  duracaoAnos Int

  disciplinas Disciplina[]
  turmas      Turma[]
}

model Disciplina {
  id           String @id @default(cuid())
  nome         String
  codigo       String @unique
  cargaHoraria Int
  cursoId      String
  curso        Curso  @relation(fields: [cursoId], references: [id])

  turmaDisciplinas TurmaDisciplina[]
}

/// Uma "turma" é uma coorte de alunos: Curso + Ano curricular + Período, num ano letivo.
model Turma {
  id            String  @id @default(cuid())
  cursoId       String
  curso         Curso   @relation(fields: [cursoId], references: [id])
  anoCurricular Int
  periodo       Periodo
  anoLetivo     Int

  matriculas       Matricula[]
  turmaDisciplinas TurmaDisciplina[]

  @@unique([cursoId, anoCurricular, periodo, anoLetivo])
}

/// Uma disciplina lecionada por um professor dentro de uma turma (coorte). Cada disciplina tem o seu próprio semestre.
model TurmaDisciplina {
  id           String     @id @default(cuid())
  turmaId      String
  turma        Turma      @relation(fields: [turmaId], references: [id], onDelete: Cascade)
  disciplinaId String
  disciplina   Disciplina @relation(fields: [disciplinaId], references: [id])
  professorId  String
  professor    Professor  @relation(fields: [professorId], references: [id])
  semestre     Int
  sala         String

  avaliacoes   Avaliacao[]
  aulas        Aula[]
  horarioSlots HorarioSlot[]

  @@unique([turmaId, disciplinaId])
}

model HorarioSlot {
  id                String          @id @default(cuid())
  turmaDisciplinaId String
  turmaDisciplina   TurmaDisciplina @relation(fields: [turmaDisciplinaId], references: [id], onDelete: Cascade)
  diaSemana         DiaSemana
  horaInicio        String
  horaFim           String
  sala              String
}

model Matricula {
  id            String          @id @default(cuid())
  alunoId       String
  aluno         Aluno           @relation(fields: [alunoId], references: [id])
  turmaId       String
  turma         Turma           @relation(fields: [turmaId], references: [id])
  dataMatricula DateTime        @default(now())
  status        MatriculaStatus @default(ATIVA)

  notas       Nota[]
  frequencias Frequencia[]
  propinas    Propina[]

  @@unique([alunoId, turmaId])
}

model Avaliacao {
  id                String          @id @default(cuid())
  turmaDisciplinaId String
  turmaDisciplina   TurmaDisciplina @relation(fields: [turmaDisciplinaId], references: [id], onDelete: Cascade)
  tipo              AvaliacaoTipo
  peso              Decimal         @db.Decimal(4, 2)
  data              DateTime
  nome              String
  sala              String?

  notas Nota[]
}

model Nota {
  id          String    @id @default(cuid())
  avaliacaoId String
  avaliacao   Avaliacao @relation(fields: [avaliacaoId], references: [id])
  matriculaId String
  matricula   Matricula @relation(fields: [matriculaId], references: [id])
  valor       Decimal   @db.Decimal(4, 2)
  lancadoEm   DateTime  @default(now())

  @@unique([avaliacaoId, matriculaId])
}

model Aula {
  id                String          @id @default(cuid())
  turmaDisciplinaId String
  turmaDisciplina   TurmaDisciplina @relation(fields: [turmaDisciplinaId], references: [id], onDelete: Cascade)
  data              DateTime
  tema              String?

  frequencias Frequencia[]
}

model Frequencia {
  id          String    @id @default(cuid())
  aulaId      String
  aula        Aula      @relation(fields: [aulaId], references: [id])
  matriculaId String
  matricula   Matricula @relation(fields: [matriculaId], references: [id])
  presente    Boolean
  justificada Boolean?

  @@unique([aulaId, matriculaId])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  userName   String
  userRole   Role
  action     String
  entityType String
  entityId   String?
  details    String?
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([userId])
  @@index([createdAt])
}

enum PropinaStatus {
  PENDENTE
  PAGO
}

/// Uma mensalidade (propina) devida por um aluno, referente a um mês de um ano letivo.
/// Ligada à Matricula para saber curso/turma na altura, mas a unicidade e os totais são por Aluno,
/// para a dívida seguir o aluno mesmo que a matrícula mude.
model Propina {
  id             String        @id @default(cuid())
  matriculaId    String
  matricula      Matricula     @relation(fields: [matriculaId], references: [id])
  alunoId        String
  aluno          Aluno         @relation(fields: [alunoId], references: [id])
  mesReferencia  DateTime
  valorDevido    Decimal       @db.Decimal(10, 2)
  valorPago      Decimal       @default(0) @db.Decimal(10, 2)
  status         PropinaStatus @default(PENDENTE)
  dataVencimento DateTime
  dataPagamento  DateTime?
  registadoPorId String?
  registadoPor   User?         @relation("PropinaRegistadaPor", fields: [registadoPorId], references: [id])
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@unique([alunoId, mesReferencia])
  @@index([alunoId])
  @@index([status])
}

/// Configuração singleton do bloqueio por dívida (id fixo "config").
model ConfiguracaoFinanceira {
  id                String   @id @default("config")
  bloqueioAtivo     Boolean  @default(true)
  toleranciaDias    Int      @default(5)
  valorMensalPadrao Decimal  @default(15000) @db.Decimal(10, 2)
  updatedAt         DateTime @updatedAt
  updatedPorId      String?
  updatedPor        User?    @relation("ConfigFinanceiraAtualizadaPor", fields: [updatedPorId], references: [id])
}
