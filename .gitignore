# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# local load/stress test logs
/stress-logs

# simulação de ano letivo — relógio partilhado com o servidor + relatórios/screenshots gerados
/scripts/simulacao/.relogio
/scripts/simulacao/output

# dev server / simulação locais (logs e pids)
/next-dev-local.log
/next-dev-local.pid
/simulacao-local.log
/simulacao-local.pid

# scripts temporários de teste (padrão tmp-*) + screenshots de passes visuais
/scripts/tmp-*

# graphify knowledge-graph analysis output (generated, not source)
/graphify-out

# manual da faculdade — as capturas saem a 2x (dezenas de MB) e o HTML/PDF são compostos a partir
# delas; tudo isto se regenera com scripts/manual/. O que fica versionado é o guião
# (scripts/manual/paginas.ts) e o manifesto com o texto das legendas (docs/manual/capturas.json).
/docs/manual/imagens
/docs/manual/manual.html
/docs/manual/*.pdf
/docs/manual/*.log

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# AI assistant skill caches (auto-installed by `prisma init`)
/.claude
/.agents
/.windsurf
skills-lock.json

.vercel
.env*
